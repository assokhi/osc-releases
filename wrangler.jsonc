// Static site on Cloudflare Workers (assets only, no Worker script). See docs/website.md.
{
  "name": "osc",
  "compatibility_date": "2025-09-01",
  // Wrangler runs this itself before every deploy, so `dist/` exists even if the
  // Cloudflare dashboard's own "Build command" field is empty or wrong.
  "build": {
    "command": "npm run build && npm run check"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
