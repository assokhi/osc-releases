---
import InstallCommand from "../ui/InstallCommand.astro";
import { site } from "../../data/site";
---

<section class="overflow-hidden pt-12 pb-20 sm:pt-16 sm:pb-28">
  <div class="mx-auto max-w-5xl px-4 text-center sm:px-6">
    <h1><img src="/icon.png" alt={site.name} width="256" height="256" class="mx-auto size-28 sm:size-40" /></h1>
    <p class="mx-auto mt-6 max-w-2xl font-display text-2xl font-semibold tracking-tight text-balance sm:text-4xl">{site.tagline}</p>

    <p class="mt-6 flex items-center justify-center gap-2 text-base text-muted">
      <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M0 3.5 9.75 2.2v9.3H0Zm10.75-1.4L24 0v11.5H10.75Zm-10.75 10h9.75v9.4L0 20.5Zm10.75 0H24V24l-13.25-1.9Z"/></svg>
      Only available on Windows
    </p>

    <div id="install" class="mx-auto mt-8 max-w-3xl scroll-mt-24">
      <InstallCommand />
    </div>

    <p class="mx-auto mt-4 flex max-w-md flex-wrap items-center justify-center gap-x-2 gap-y-1 text-center text-base text-muted">
      <svg viewBox="0 0 24 24" class="size-5 shrink-0 fill-fg" aria-hidden="true">
        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
      </svg>
      Hit a problem, or have an idea? <a href={site.issues} class="text-link hover:underline">Raise an issue on GitHub</a>
    </p>
  </div>
</section>
