---
// A full-width band with a centered heading. level=1 makes it the page title.
interface Props {
  id?: string;
  title: string;
  lead?: string;
  level?: 1 | 2;
  tone?: "plain" | "muted";
}
const { id, title, lead, level = 2, tone = "plain" } = Astro.props;
const Heading = level === 1 ? "h1" : "h2";
---

<section id={id} class:list={["py-20 sm:py-24", tone === "muted" && "bg-surface-2"]}>
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <header class="mx-auto max-w-2xl text-center">
      <Heading class:list={[level === 1 ? "text-5xl sm:text-6xl" : "text-4xl sm:text-5xl"]}>{title}</Heading>
      {lead && <p class="mt-4 text-xl leading-relaxed text-muted">{lead}</p>}
    </header>
    <slot />
  </div>
</section>
