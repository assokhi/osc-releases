---
import { nav, site } from "../../data/site";

// "/docs.html" and "/docs/" both count as "/docs"
const current = Astro.url.pathname.replace(/(\.html|\/)$/, "") || "/";
---

<header class="sticky top-0 z-40 border-b border-line/60 bg-surface/80 backdrop-blur-xl backdrop-saturate-150">
  <nav aria-label="Main" class="mx-auto flex h-16 max-w-5xl items-center gap-6 px-4 text-base sm:px-6">
    <a href="/" class="mr-auto flex items-center gap-2.5 text-lg font-semibold">
      <img src="/icon.png" alt="" width="28" height="28" class="size-7" />
      {site.name}
    </a>
    <ul class="flex items-center gap-6 sm:gap-8">
      {
        nav.map((link) => (
          <li>
            <a href={link.href} aria-current={current === link.href ? "page" : undefined} class="text-fg/80 transition hover:text-fg aria-[current=page]:text-fg">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
