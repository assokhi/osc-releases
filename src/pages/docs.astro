---
import InstallCommand from "../components/ui/InstallCommand.astro";
import { Content, getHeadings } from "../data/docs.md";
import Base from "../layouts/Base.astro";

const toc = getHeadings().filter((h) => h.depth === 2);
---

<Base
  title="Docs · osc"
  description="Install osc, connect your Telegram group, upload, view and stream files, update and uninstall, and see what osc keeps where."
  theme="dark"
>
  <div class="mx-auto grid max-w-5xl gap-12 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[12rem_1fr]">
    <nav aria-label="On this page" class="hidden lg:sticky lg:top-20 lg:block lg:self-start">
      <p class="text-sm font-semibold">On this page</p>
      <ul class="mt-3 space-y-2 border-l border-line text-sm">
        {
          toc.map((h) => (
            <li>
              <a href={`#${h.slug}`} class="-ml-px block border-l border-transparent pl-4 text-muted transition hover:border-fg hover:text-fg">
                {h.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <article
      class="prose prose-lg max-w-3xl min-w-0 prose-headings:scroll-mt-24 prose-a:font-medium prose-code:rounded-md prose-code:bg-surface-2 prose-code:px-1.5 prose-code:py-0.5 prose-code:font-normal prose-code:[overflow-wrap:anywhere] prose-code:before:content-none prose-code:after:content-none"
    >
      <h1>Docs.</h1>
      <p class="lead">Everything you need to install osc and use it day to day.</p>
      <div class="not-prose my-8">
        <p class="mb-3 text-sm font-semibold">Quick install</p>
        <InstallCommand />
      </div>
      <Content />
    </article>
  </div>
</Base>
